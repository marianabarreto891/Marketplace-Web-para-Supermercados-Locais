<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Gerir Categorias</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <h1>Categorias do Sistema</h1>
    <a href="/admin/dashboard" class="btn btn-secondary mb-3">Voltar</a>

    <form action="/admin/categories/new" method="POST" class="mb-4 p-3 border rounded">
        <h4>Nova Categoria</h4>
        <input type="text" name="name" class="form-control mb-2" placeholder="Nome (Ex: Frutas)" required>
        <textarea name="description" class="form-control mb-2" placeholder="Descrição"></textarea>
        <button type="submit" class="btn btn-primary">Adicionar</button>
    </form>

    <ul class="list-group">
        <% categories.forEach(cat => { %>
            <li class="list-group-item"><strong><%= cat.name %></strong> - <%= cat.description %></li>
        <% }) %>
    </ul>
</body>
</html>