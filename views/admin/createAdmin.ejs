<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Criar Novo Administrador</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h1 class="h3 mb-0">Novo Administrador</h1>
          <a href="/admin/users" class="btn btn-secondary btn-sm">Voltar</a>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <form action="/admin/createAdmin" method="POST">
              <div class="mb-3">
                <label class="form-label fw-semibold">Nome Completo</label>
                <input type="text" name="name" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input type="email" name="email" class="form-control" placeholder="nome@exemplo.com" required>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <input type="password" name="password" class="form-control" required>
              </div>

              <div class="row mb-4">
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Telemóvel</label>
                  <input type="tel" name="phone" class="form-control" pattern="[0-9]{9}" maxlength="9"
                                placeholder="Ex: 912345678" title="O número deve ter exatamente 9 dígitos" required>
                </div>
                <div class="col-md-6 mt-3 mt-md-0">
                  <label class="form-label fw-semibold">Morada</label>
                  <input type="text" name="address" class="form-control" required>
                </div>
              </div>

              <button type="submit" class="btn btn-success w-100">Registar Administrador</button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</body>
</html>