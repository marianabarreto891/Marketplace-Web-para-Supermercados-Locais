<%- include('../partials/head', { title: 'Editar Categoria' }) %>
<body class="container mt-5">
    <h1>Editar Categoria</h1>
    <a href="/admin/categories" class="btn btn-secondary mb-3">Voltar às Categorias</a>

    <form action="/admin/categories/<%= category._id %>/edit" method="POST" class="p-3 border rounded">
        <div class="mb-3">
            <label class="form-label fw-semibold">Nome</label>
            <input type="text" name="name" class="form-control" value="<%= category.name %>" required>
        </div>
        <button type="submit" class="btn btn-primary">Guardar alterações</button>
    </form>
</body>
</html>