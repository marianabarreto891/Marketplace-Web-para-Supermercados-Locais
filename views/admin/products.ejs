<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestao de Produtos</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light p-4">
    <div class="container bg-white p-4 rounded shadow-sm">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 border-bottom pb-3 mb-4">
            <div>
                <h1 class="mb-1">Gestao de Produtos</h1>
                <p class="text-muted mb-0">Consulta, edicao, desativacao e remocao de produtos do sistema.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/admin/dashboard" class="btn btn-secondary">Voltar ao Dashboard</a>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form action="/admin/products" method="GET" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Pesquisar produto</label>
                        <input
                            type="text"
                            name="search"
                            class="form-control"
                            placeholder="Nome do produto"
                            value="<%= filters.search %>"
                        >
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Supermercado</label>
                        <select name="supermarketId" class="form-select">
                            <option value="">Todos</option>
                            <% supermarkets.forEach((supermarket) => { %>
                                <option value="<%= supermarket._id %>" <%= filters.supermarketId === String(supermarket._id) ? "selected" : "" %>>
                                    <%= supermarket.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Categoria</label>
                        <select name="categoryId" class="form-select">
                            <option value="">Todas</option>
                            <% categories.forEach((category) => { %>
                                <option value="<%= category._id %>" <%= filters.categoryId === String(category._id) ? "selected" : "" %>>
                                    <%= category.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Estado</label>
                        <select name="status" class="form-select">
                            <option value="" <%= !filters.status ? "selected" : "" %>>Todos</option>
                            <option value="active" <%= filters.status === "active" ? "selected" : "" %>>Ativos</option>
                            <option value="inactive" <%= filters.status === "inactive" ? "selected" : "" %>>Inativos</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <% if (!products.length) { %>
                    <div class="alert alert-info mb-0">Nao foram encontrados produtos para os filtros escolhidos.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Produto</th>
                                    <th>Supermercado</th>
                                    <th>Categoria</th>
                                    <th>Preco</th>
                                    <th>Stock</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acoes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% products.forEach((product) => { %>
                                    <tr>
                                        <td>
                                            <div class="fw-semibold"><%= product.name %></div>
                                            <div class="small text-muted"><%= product.description || "-" %></div>
                                        </td>
                                        <td>
                                            <div><%= product.supermarket ? product.supermarket.name : "-" %></div>
                                            <div class="small text-muted"><%= product.supermarket ? product.supermarket.location : "" %></div>
                                        </td>
                                        <td><%= product.category ? product.category.name : "-" %></td>
                                        <td>€ <%= Number(product.price).toFixed(2) %></td>
                                        <td><%= product.stock %></td>
                                        <td>
                                            <span class="badge <%= product.isActive === false ? "bg-danger" : "bg-success" %>">
                                                <%= product.isActive === false ? "Inativo" : "Ativo" %>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                                <% if (product.supermarket) { %>
                                                    <a
                                                        href="/supermarket/<%= product.supermarket._id %>/products/<%= product._id %>/edit"
                                                        class="btn btn-sm btn-warning"
                                                    >
                                                        Editar
                                                    </a>
                                                <% } %>
                                                <form action="/admin/products/<%= product._id %>/toggle" method="POST">
                                                    <button type="submit" class="btn btn-sm <%= product.isActive === false ? "btn-success" : "btn-outline-danger" %>">
                                                        <%= product.isActive === false ? "Ativar" : "Desativar" %>
                                                    </button>
                                                </form>
                                                <form
                                                    action="/admin/products/<%= product._id %>/delete"
                                                    method="POST"
                                                    onsubmit="return confirm('Tens a certeza que queres apagar este produto?')"
                                                >
                                                    <button type="submit" class="btn btn-sm btn-danger">Apagar</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
