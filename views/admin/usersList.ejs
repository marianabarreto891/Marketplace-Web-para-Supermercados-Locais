<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Lista de Utilizadores</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light p-4">

<div class="container bg-white p-4 rounded shadow-sm">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <h1 class="mb-0">Lista de Utilizadores do Sistema</h1>
        <a href="/admin/createAdmin" class="btn btn-success">Criar Novo Admin</a>
        <a href="/admin/dashboard" class="btn btn-secondary">Voltar ao Dashboard</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Telefone</th>
                    <th>Tipo de Utilizador</th>
                </tr>
            </thead>
            <tbody>
                <% allUsers.forEach(function(user) { %>
                    <tr>
                        <td class="align-middle"><%= user.name %></td>
                        <td class="align-middle"><%= user.email %></td>
                        <td class="align-middle"><%= user.phone ||'-' %></td>
                        <td class="align-middle">
                            <% if(user.role === 'admin') { %>
                                <span class="badge bg-danger">Admin</span>
                            <% } else if(user.role === 'supermercado') { %>
                                <span class="badge bg-success">Supermercado</span>
                            <% } else if(user.role === 'estafeta') { %>
                                <span class="badge bg-warning text-dark">Estafeta</span>
                            <% } else { %>
                                <span class="badge bg-info text-dark">Cliente</span>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

</body>
</html>
