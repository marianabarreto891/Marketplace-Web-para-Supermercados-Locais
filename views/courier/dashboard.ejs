<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard do Estafeta</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%
    const statusClasses = {
      pendente: "bg-secondary",
      confirmada: "bg-primary",
      em_preparacao: "bg-warning text-dark",
      em_entrega: "bg-info text-dark",
      entregue: "bg-success",
      cancelada: "bg-danger",
    };

    const hasActiveDelivery = summary.activeDeliveries > 0;
  %>

  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Estafeta</h1>
        <p class="text-muted mb-0">Resumo das entregas, disponibilidades e supermercados com mais entregas.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/orders" class="btn btn-primary">Ver entregas</a>
        <a href="/supermarket/list" class="btn btn-outline-secondary">Supermercados</a>
        <a href="/users/profile" class="btn btn-outline-primary">Ver perfil</a>
        <a href="/users/logout" class="btn btn-danger">Terminar sessão</a>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Número de entregas</div>
            <div class="display-6 fw-bold"><%= summary.totalDeliveries %></div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">A aguardar preparação</div>
            <div class="display-6 fw-bold"><%= summary.pendingPreparation %></div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Disponíveis para aceitar</div>
            <div class="display-6 fw-bold"><%= summary.availableDeliveries %></div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Entregas em curso</div>
            <div class="display-6 fw-bold"><%= summary.activeDeliveries %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h4 mb-0">Supermercados com mais entregas</h2>
              <span class="badge bg-secondary"><%= topSupermarkets.length %></span>
            </div>

            <% if (!topSupermarkets.length) { %>
              <div class="alert alert-info mb-0">Ainda não existem entregas suficientes para calcular este ranking!</div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Supermercado</th>
                      <th>Entregas</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% topSupermarkets.forEach((supermarket) => { %>
                      <tr>
                        <td>
                          <div class="fw-semibold"><%= supermarket.name || "Supermercado removido" %></div>
                          <div class="small text-muted"><%= supermarket.location || "-" %></div>
                        </td>
                        <td><%= supermarket.deliveries %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-xl-7">
        <div class="alert alert-info shadow-sm border-0 mb-0 h-100">
          As encomendas com entrega por estafeta aparecem aqui, logo após serem confirmadas. Enquanto estiverem em <strong>Confirmada</strong>, o supermercado ainda está a preparar o pedido. O botão de aceitar fica disponível quando a encomenda passar para <strong>Em preparação</strong>.
          <% if (hasActiveDelivery) { %>
            <hr>
            <strong>Nota:</strong> Só pode realizar uma entrega de cada vez. Termine a entrega atual para aceitar a próxima!
          <% } %>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 mb-0">Últimas entregas e pedidos disponíveis</h2>
          <a href="/orders" class="btn btn-outline-primary btn-sm">Abrir listagem</a>
        </div>

        <% if (!recentOrders.length) { %>
          <div class="alert alert-info mb-0">Ainda não existem registos para mostrar.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead class="table-light">
                <tr>
                  <th>Data</th>
                  <th>Supermercado</th>
                  <th>Cliente</th>
                  <th>Estado</th>
                  <th>Disponibilidade</th>
                  <th>Total</th>
                  <th class="text-end">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach((order) => { %>
                  <%
                    const orderCourierId =
                      order.estafeta && order.estafeta._id
                        ? String(order.estafeta._id)
                        : order.estafeta
                        ? String(order.estafeta)
                        : null;
                    const isMine = orderCourierId && orderCourierId === currentCourierId;
                  %>
                  <tr>
                    <td><%= new Date(order.createdAt).toLocaleString("pt-PT") %></td>
                    <td><%= order.supermercado ? order.supermercado.name : "-" %></td>
                    <td><%= order.cliente ? order.cliente.name : "-" %></td>
                    <td>
                      <span class="badge <%= statusClasses[order.estado] %>"><%= statusLabels[order.estado] %></span>
                    </td>
                    <td>
                      <% if (isMine && order.estado === "em_entrega") { %>
                        <span class="badge bg-info text-dark">Entrega em curso</span>
                      <% } else if (isMine && order.estado === "entregue") { %>
                        <span class="badge bg-success">Entrega concluída</span>
                      <% } else if (order.estafetaDisplayName && order.estafetaDisplayName !== "-" && !isMine) { %>
                        <span class="small text-muted">Ja atribuída a <%= order.estafetaDisplayName %></span>
                      <% } else if (order.estado === "confirmada") { %>
                        <span class="small text-muted">A aguardar preparação</span>
                      <% } else if (order.estado === "em_preparacao" && hasActiveDelivery) { %>
                        <span class="small text-muted">Termine a entrega atual</span>
                      <% } else if (order.estado === "em_preparacao") { %>
                        <span class="badge bg-success-subtle text-success">Pode aceitar</span>
                      <% } else { %>
                        <span class="small text-muted">Sem disponibilidade agora</span>
                      <% } %>
                    </td>
                    <td>€ <%= Number(order.total).toFixed(2) %></td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-2 flex-wrap">
                        <% if (!order.estafeta && order.estado === "em_preparacao" && !hasActiveDelivery) { %>
                          <form action="/orders/<%= order._id %>/claim" method="POST">
                            <button type="submit" class="btn btn-sm btn-primary">Aceitar</button>
                          </form>
                        <% } %>
                        <a href="/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary">Detalhe</a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
