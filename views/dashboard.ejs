<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard de Supermercado</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <% if (role === "supermercado") { %>
          <h1 class="mb-1">Dashboard</h1>
          <p class="text-muted mb-0">Resumo de vendas, encomendas e supermercados geridos.</p>
        <% } else { %>
          <h1 class="mb-1">Dashboard de estafeta</h1>
          <p class="text-muted mb-0">Resumo das entregas disponíveis e das suas entregas.</p>
        <% } %>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/orders" class="btn btn-primary"><%= role === "supermercado" ? "Ver encomendas" : "Ver entregas" %></a>
        <a href="/supermarket/list" class="btn btn-outline-secondary">Supermercados</a>
        <a href="/users/logout" class="btn btn-danger">Terminar sessão</a>
      </div>
    </div>

    <% if (role === "supermercado") { %>
      <div class="row g-4 mb-4">
        <div class="col-md-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="text-muted small">Total de vendas</div>
              <div class="display-6 fw-bold"><%= summary.totalOrders %></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="text-muted small">Encomendas ativas</div>
              <div class="display-6 fw-bold"><%= summary.openOrders %></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="text-muted small">Supermercados aprovados</div>
              <div class="display-6 fw-bold"><%= summary.approvedSupermarkets %></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="text-muted small">Total vendido</div>
              <div class="display-6 fw-bold">€  <%= Number(summary.totalRevenue).toFixed(2) %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Supermercados registados</h2>
            <a href="/supermarket/new" class="btn btn-outline-primary btn-sm">Adicionar novo supermercado</a>
          </div>

          <% if (!supermarkets.length) { %>
            <div class="alert alert-info mb-0">Ainda não tem supermercados registados!</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Nome</th>
                    <th>Estado</th>
                    <th>Entrega</th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% supermarkets.forEach((supermarket) => { %>
                    <tr>
                      <td>
                        <div class="fw-semibold"><%= supermarket.name %></div>
                        <div class="small text-muted"><%= supermarket.location %></div>
                      </td>
                      <td>
                        <span class="badge <%= !supermarket.toApprove ? 'bg-warning text-dark' : supermarket.isApproved ? 'bg-success' : 'bg-danger' %>">
                          <%= !supermarket.toApprove ? 'Pendente' : supermarket.isApproved ? 'Aprovado' : 'Rejeitado' %>
                        </span>
                      </td>
                      <td>
                        <%= supermarket.deliveryMethods.map((method) => deliveryLabels[method]).join(", ") %>
                      </td>
                      <td class="text-end">
                        <div class="d-flex justify-content-end flex-wrap gap-2">
                          <a href="/supermarket/<%= supermarket._id %>" class="btn btn-sm btn-outline-secondary">Detalhe</a>
                          <a href="/orders?supermarketId=<%= supermarket._id %>" class="btn btn-sm btn-outline-primary">Encomendas</a>
                          <% if (supermarket.isApproved) { %>
                            <a href="/orders/create/<%= supermarket._id %>" class="btn btn-sm btn-primary">Nova venda</a>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="row g-4 mb-4">
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="text-muted small">Entregas disponíveis</div>
              <div class="display-6 fw-bold"><%= summary.availableDeliveries %></div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="text-muted small">Entregas em curso</div>
              <div class="display-6 fw-bold"><%= summary.activeDeliveries %></div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="text-muted small">Entregas concluídas</div>
              <div class="display-6 fw-bold"><%= summary.deliveredCount %></div>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 mb-0"><%= role === "supermercado" ? "Últimas encomendas" : "Últimas entregas" %></h2>
          <a href="/orders" class="btn btn-outline-primary btn-sm">Abrir listagem</a>
        </div>

        <% if (!recentOrders.length) { %>
          <div class="alert alert-info mb-0">Ainda não há registos para mostrar!</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead class="table-light">
                <tr>
                  <th>Data</th>
                  <th>Supermercado</th>
                  <th>Cliente</th>
                  <th>Estado</th>
                  <th>Total</th>
                  <th class="text-end">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach((order) => { %>
                  <tr>
                    <td><%= new Date(order.createdAt).toLocaleString("pt-PT") %></td>
                    <td><%= order.supermercado ? order.supermercado.name : "-" %></td>
                    <td><%= order.cliente ? order.cliente.name : "-" %></td>
                    <td><%= statusLabels[order.estado] %></td>
                    <td>EUR <%= Number(order.total).toFixed(2) %></td>
                    <td class="text-end">
                      <a href="/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary">Detalhe</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
