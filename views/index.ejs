<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bem-vindo - Marketplace Local</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>

body {
  margin: 0;
  padding: 0;
  background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
              url('https://images.unsplash.com/photo-1542838132-92c53300491e?q=80&w=1920&auto=format&fit=crop') no-repeat center center fixed !important;
  background-size: cover !important;
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}


h1 {
  color: #ffffff !important; /* Texto agora é totalmente branco */
  font-weight: bold;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.6); 
  text-align: center;
  margin-bottom: 0.5rem;
}

p.text-muted {
  color: #ffffff !important; 
  text-align: center;
  font-size: 1.1rem;
  margin-bottom: 1.5rem;
}


.btn {
  border-radius: 12px !important;
  font-weight: 600;
  padding: 0.75rem 2.5rem;
  transition: transform 0.2s, background-color 0.2s;
}

.btn:hover {
  transform: translateY(-2px); 
}


.btn-primary {
  background-color: #00e676 !important; 
  border-color: #00e676 !important;
  color: #000000 !important;
}

.btn-primary:hover {
  background-color: #00c853 !important;
}


.btn-outline-primary, .btn-outline-secondary, .btn-secondary {
  background-color: #ff3d00 !important; 
  border-color: #ff3d00 !important;
  color: #ffffff !important;
}

.btn-outline-primary:hover, .btn-outline-secondary:hover, .btn-secondary:hover {
  background-color: #dd2c00 !important;
  color: #ffffff !important;
}


.card {
  background-color: rgba(255, 255, 255, 0.90) !important; /* Fundo quase opaco mas deixa ver um bocadinho do fundo */
  border: none !important;
  border-radius: 16px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
  margin-top: 2rem;
  width: 90%; 
  max-width: 1000px;
  backdrop-filter: blur(8px); /* Esbate o fundo que passa por trás da tabela */
}

.table {
  margin-bottom: 0;
}

.table-light th {
  background-color: #f3f4f6 !important;
  text-transform: uppercase;
  font-size: 0.75rem;
  color: #4b5563;
}
</style>
</head>
<body>
    <div class="hero-section text-center">
        <div class="container">
            <h1 class="display-4 fw-bold text-primary mb-3">Marketplace de Supermercados Locais</h1>
            <p class="lead text-muted mb-5">Compre nos seus supermercados favoritos, compare preços e receba em casa.</p>
            
            <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                <a href="/users/login" class="btn btn-primary btn-lg px-4">Entrar na Conta</a>
                <a href="/users/register" class="btn btn-outline-secondary btn-lg px-4">Criar Conta</a>
            </div>
        </div>
    </div>
</body>
</html>