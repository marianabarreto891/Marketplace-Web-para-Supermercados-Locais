<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Lista</title>
    <style>
        table { width: 50%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
    <h1>Produtos Adicionados</h1>
    <table>
        <tr>
            <th>Nome</th>
            <th>Preço</th>
            <th>Stock</th>
        </tr>
        <% products.forEach(function(p) { %>
            <tr>
                <td><%= p.name %></td>
                <td><%= p.price %>€</td>
                <td><%= p.stock %></td>
            </tr>
        <% }); %>
    </table>
    <br>
    <a href="/supermarket/<%= supermarketId %>/products/new">Adicionar outro produto</a>
</body>
</html>