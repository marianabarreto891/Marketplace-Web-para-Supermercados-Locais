<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adicionar Produto</title>
</head>
<body>
    <h1>Adicionar Novo Produto</h1>
    
    <form action="/supermarket/<%= supermarketId %>/products/new" method="POST">
        
        <label>Nome do Produto:</label><br>
        <input type="text" name="name" required><br><br>

        <label>Descrição:</label><br>
        <textarea name="description"></textarea><br><br>

        <label>Categoria:</label><br>
        <input type="text" name="category" placeholder="Ex: Frutas" required><br><br>

        <label>Preço (€):</label><br>
        <input type="number" step="0.01" name="price" required><br><br>

        <label>URL da Imagem:</label><br>
        <input type="text" name="image"><br><br>

        <label>Stock Disponível:</label><br>
        <input type="number" name="stock" value="0" required><br><br>

        <button type="submit">Guardar Produto</button>
    </form>
</body>
</html>