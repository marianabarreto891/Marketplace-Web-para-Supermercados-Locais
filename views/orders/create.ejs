<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nova Venda</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Nova venda</h1>
        <p class="text-muted mb-0">Registo de venda para <strong><%= supermarket.name %></strong></p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/orders?supermarketId=<%= supermarket._id %>" class="btn btn-outline-primary">Ver encomendas</a>
        <a href="/supermarket/<%= supermarket._id %>" class="btn btn-outline-secondary">Voltar ao supermercado</a>
      </div>
    </div>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <% if (!products.length) { %>
      <div class="alert alert-warning">
        Ainda nao existem produtos neste supermercado. Cria primeiro os produtos para poderes registar vendas.
      </div>
    <% } else { %>
      <form action="/orders/create/<%= supermarket._id %>" method="POST">
        <div class="row g-4">
          <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-body">
                <h2 class="h4 mb-3">Cliente</h2>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Nome</label>
                  <input type="text" name="name" class="form-control" required value="<%= customer.name || '' %>">
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Email</label>
                  <input type="email" name="email" class="form-control" required value="<%= customer.email || '' %>">
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Morada</label>
                  <input type="text" name="address" class="form-control" required value="<%= customer.address || '' %>">
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold">Telefone</label>
                  <input type="text" name="phone" class="form-control" required value="<%= customer.phone || '' %>">
                </div>

                <h2 class="h4 mb-3">Entrega</h2>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Metodo de entrega</label>
                  <select name="metodoEntrega" class="form-select" required>
                    <% supermarket.deliveryMethods.forEach((method) => { %>
                      <option value="<%= method %>" <%= deliveryMethod === method ? "selected" : "" %>>
                        <%= deliveryLabels[method] %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="small text-muted">
                  Custo de entrega por estafeta: EUR <%= Number(supermarket.deliveryCost || 0).toFixed(2) %>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-8">
            <div class="card shadow-sm border-0">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h2 class="h4 mb-0">Produtos</h2>
                  <span class="badge bg-secondary"><%= products.length %> disponiveis</span>
                </div>

                <div class="table-responsive">
                  <table class="table align-middle">
                    <thead class="table-light">
                      <tr>
                        <th>Selecionar</th>
                        <th>Produto</th>
                        <th>Preco</th>
                        <th>Stock</th>
                        <th>Quantidade</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% products.forEach((product, index) => { %>
                        <% const productId = product._id.toString(); %>
                        <% const selected = selectedProductIds.includes(productId); %>
                        <% const quantity = quantities[productId] || 1; %>
                        <% const outOfStock = product.stock <= 0; %>
                        <tr class="<%= outOfStock ? 'table-secondary' : '' %>">
                          <td>
                            <input
                              class="form-check-input"
                              type="checkbox"
                              name="items[<%= index %>][selected]"
                              value="1"
                              <%= selected ? "checked" : "" %>
                              <%= outOfStock ? "disabled" : "" %>>
                            <input type="hidden" name="items[<%= index %>][productId]" value="<%= productId %>">
                          </td>
                          <td>
                            <div class="fw-semibold"><%= product.name %></div>
                            <% if (product.description) { %>
                              <div class="small text-muted"><%= product.description %></div>
                            <% } %>
                          </td>
                          <td>EUR <%= Number(product.price).toFixed(2) %></td>
                          <td>
                            <% if (outOfStock) { %>
                              <span class="badge bg-danger">Sem stock</span>
                            <% } else { %>
                              <span class="badge bg-success-subtle text-success"><%= product.stock %></span>
                            <% } %>
                          </td>
                          <td style="max-width: 140px;">
                            <input
                              type="number"
                              class="form-control"
                              name="items[<%= index %>][quantity]"
                              min="1"
                              max="<%= product.stock %>"
                              value="<%= quantity %>"
                              <%= outOfStock ? "disabled" : "" %>>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <a href="/supermarket/<%= supermarket._id %>" class="btn btn-outline-secondary">Cancelar</a>
          <button type="submit" class="btn btn-primary">Criar venda</button>
        </div>
      </form>
    <% } %>
  </div>
</body>
</html>
