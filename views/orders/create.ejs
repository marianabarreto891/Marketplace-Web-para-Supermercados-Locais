<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nova Venda</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Nova venda</h1>
        <p class="text-muted mb-0">Registo de venda para <strong><%= supermarket.name %></strong></p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/orders?supermarketId=<%= supermarket._id %>" class="btn btn-outline-primary">Ver encomendas</a>
        <a href="/supermarket/<%= supermarket._id %>" class="btn btn-outline-secondary">Voltar ao supermercado</a>
      </div>
    </div>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <% if (!products.length) { %>
      <div class="alert alert-warning">
        Ainda nao existem produtos neste supermercado. Crie primeiro os produtos para poder registar vendas.
      </div>
    <% } else { %>
    
      <form action="/orders/create/<%= supermarket._id %>" method="POST">
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
              <div>
                <h2 class="h4 mb-1">Produtos</h2>
                <p class="text-muted mb-0">Pesquise para filtrar a lista e registar a venda mais depressa.</p>
              </div>
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary" id="visibleProductsCounter"><%= products.length %> visíveis</span>
                <span class="badge bg-dark"><%= products.length %> disponíveis</span>
              </div>
            </div>

            <div class="row g-3 align-items-end mb-4">
              <div class="col-md-5">
                <label class="form-label fw-semibold">Categoria</label>
                <select id="categorySelect" class="form-select">
                  <option value="all">Todas</option>
                  <% 
                    const categories = [...new Set(
                      products.filter(p => p.category && p.category.name).map(p => p.category.name)
                    )];
                    categories.forEach(cat => { 
                  %>
                    <option value="<%= cat %>"><%= cat %></option>
                  <% }) %>
                </select>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold" for="productSearch">Pesquisar produto</label>
                <input type="text" id="productSearch" class="form-control" placeholder="Nome ou descrição">
              </div>

              <div class="col-md-3 d-flex gap-2">
                <button type="button" id="btnApplyFilter" class="btn btn-primary flex-fill">Filtrar</button>
                <button type="button" id="clearProductSearch" class="btn btn-outline-secondary flex-fill">Limpar</button>
              </div>
            </div>

            <div class="row mb-4">
              <div class="col-md-5">
                <label class="form-label fw-semibold text-primary" for="barcodeInput">Leitor de Código de Barras</label>
                <input type="text" id="barcodeInput" class="form-control border-primary" placeholder="Insira o ID do produto e prima Enter">
              </div>
            </div>

            <div class="alert alert-success d-flex justify-content-between align-items-center mb-4">
              <span class="fs-5">Total da Venda em tempo real:</span>
              <strong class="fs-4" id="liveTotal">EUR 0.00</strong>
            </div>

            <div class="alert alert-info d-none" id="noProductsMatch">
              Não existem produtos a corresponder a esta pesquisa.
            </div>

            <div class="table-responsive">
              <table class="table align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Selecionar</th>
                    <th style="width: 70px;">Foto</th> 
                    <th>Produto</th>
                    <th>Preço</th>
                    <th>Stock</th>
                    <th>Quantidade</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach((product, index) => { %>
                    <% const productId = product._id.toString(); %>
                    <% const selected = selectedProductIds && selectedProductIds.includes(productId); %>
                    <% const quantity = (quantities && quantities[productId]) || 1; %>
                    <% const outOfStock = product.stock <= 0; %>
                    
                    <tr 
                      data-product-row
                      data-product-id="<%= productId %>"
                      data-price="<%= product.price %>"
                      data-category="<%= product.category ? product.category.name : '' %>" 
                      data-search="<%= [product.name, product.description || ''].join(' ').toLowerCase() %>"
                      class="<%= outOfStock ? 'table-secondary' : '' %>">
                      
                      <td>
                        <input class="form-check-input" type="checkbox" name="items[<%= index %>][selected]" value="1" <%= selected ? "checked" : "" %> <%= outOfStock ? "disabled" : "" %>>
                        <input type="hidden" name="items[<%= index %>][productId]" value="<%= productId %>">
                      </td>

                      <td>
                        <% if (product.image && product.image !== 'default-product.png') { %>
                          <img src="/uploads/products/<%= product.image %>" alt="<%= product.name %>" class="rounded shadow-sm border" style="width: 45px; height: 45px; object-fit: cover;">
                        <% } else { %>
                          <div class="bg-light d-flex align-items-center justify-content-center rounded border text-muted" style="width: 45px; height: 45px; font-size: 0.7rem;">Sem foto</div>
                        <% } %>
                      </td>

                      <td>
                        <div class="fw-semibold"><%= product.name %></div>
                        <% if (product.description) { %>
                          <div class="small text-muted"><%= product.description %></div>
                        <% } %>
                      </td>
                      <td>EUR <%= Number(product.price).toFixed(2) %></td>
                      <td>
                        <% if (outOfStock) { %>
                          <span class="badge bg-danger">Sem stock</span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success"><%= product.stock %></span>
                        <% } %>
                      </td>
                      <td style="max-width: 140px;">
                        <input type="number" class="form-control" name="items[<%= index %>][quantity]" min="1" max="<%= product.stock %>" value="<%= quantity %>" <%= outOfStock ? "disabled" : "" %>>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>    

        <div class="d-flex justify-content-end gap-2 mt-4">
          <a href="/supermarket/<%= supermarket._id %>" class="btn btn-outline-secondary">Cancelar</a>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#customerModal">Continuar para Cliente</button>
        </div>

        <div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
          <div class="modal-dialog modal-lg">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="customerModalLabel">Detalhes do Cliente e Entrega</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <div class="row g-4">
                  <div class="col-md-6">
                    <h6 class="mb-3 text-primary">Informação do Cliente</h6>
                    <div class="mb-4 d-flex justify-content-center">
                      <div class="btn-group" role="group">
                        <input type="radio" class="btn-check customer-type-radio" name="customerType" id="btnNew" value="novo" checked>
                        <label class="btn btn-outline-primary" for="btnNew">Cliente Novo</label>
                        <input type="radio" class="btn-check customer-type-radio" name="customerType" id="btnExisting" value="existente">
                        <label class="btn btn-outline-primary" for="btnExisting">Cliente Existente</label>
                      </div>
                    </div>
                    <div id="newCustomerZone">
                      <div class="mb-3"><label class="form-label fw-semibold">Nome</label><input type="text" name="name" id="inputName" class="form-control" required value="<%= typeof customer !== 'undefined' && customer ? customer.name : '' %>"></div>
                      <div class="mb-3"><label class="form-label fw-semibold">Email</label><input type="email" name="email" id="inputEmail" class="form-control" required value="<%= typeof customer !== 'undefined' && customer ? customer.email : '' %>"></div>
                      <div class="mb-3"><label class="form-label fw-semibold">Morada</label><input type="text" name="address" id="inputAddress" class="form-control" required value="<%= typeof customer !== 'undefined' && customer ? customer.address : '' %>"></div>
                      <div class="mb-3"><label class="form-label fw-semibold">Telefone</label><input type="text" name="phone" id="inputPhone" class="form-control" required value="<%= typeof customer !== 'undefined' && customer ? customer.phone : '' %>"></div>
                    </div>
                    <div id="existingCustomerZone" class="d-none">
                      <div class="mb-3">
                        <label class="form-label fw-semibold">Pesquisar Cliente</label>
                        <select name="existingCustomerId" id="selectExistingCustomer" class="form-select">
                          <option value="">Selecione um cliente...</option>
                          <% if (typeof customers !== 'undefined') { %>
                            <% customers.forEach(c => { %><option value="<%= c._id %>"><%= c.name %> (<%= c.phone %>)</option><% }) %>
                          <% } %>
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <h6 class="mb-3 text-primary">Detalhes da Entrega</h6>
                    <div class="mb-3">
                      <label class="form-label fw-semibold">Método de entrega</label>
                      <select name="metodoEntrega" class="form-select" required>
                        <% supermarket.deliveryMethods.forEach((method) => { %>
                          <option value="<%= method %>" <%= (typeof deliveryMethod !== 'undefined' && deliveryMethod === method) ? "selected" : "" %>><%= deliveryLabels[method] %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div class="alert alert-info small">Custo de entrega por estafeta: <strong>EUR <%= Number(supermarket.deliveryCost || 0).toFixed(2) %></strong></div>
                  </div>
                </div>
              </div>
              <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar aos produtos</button>
                <button type="submit" class="btn btn-success">Confirmar e Registar Venda</button>
              </div>
            </div>
          </div>
        </div>
      </form>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script src="../../public/scripts/createOrdersScript.js"></script>        
</body>
</html>