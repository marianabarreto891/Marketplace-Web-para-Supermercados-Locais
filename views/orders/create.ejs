<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nova Venda</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Nova venda</h1>
        <p class="text-muted mb-0">Registo de venda para <strong><%= supermarket.name %></strong></p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/orders?supermarketId=<%= supermarket._id %>" class="btn btn-outline-primary">Ver encomendas</a>
        <a href="/supermarket/<%= supermarket._id %>" class="btn btn-outline-secondary">Voltar ao supermercado</a>
      </div>
    </div>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <% if (!products.length) { %>
      <div class="alert alert-warning">
        Ainda não existem produtos neste supermercado! Crie primeiro os produtos para poder registar vendas.
      </div>
    <% } else { %>
      <form action="/orders/create/<%= supermarket._id %>" method="POST">
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
              <div>
                <h2 class="h4 mb-1">Produtos</h2>
                <p class="text-muted mb-0">Pesquise para filtrar a lista e registar a venda mais depressa.</p>
              </div>
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary" id="visibleProductsCounter"><%= products.length %> visíveis</span>
              </div>
            </div>

            <div class="row g-3 align-items-end mb-4">
              <div class="col-md-5">
                <label class="form-label fw-semibold">Categoria</label>
                <select id="categorySelect" name="category" class="form-select">
                  <option value="all">Todas</option>
                  <%
                    const categoriesUnique = [...new Set(
                      products
                        .filter((product) => product.category && product.category.name)
                        .map((product) => product.category.name)
                    )];
                    categoriesUnique.forEach((category) => {
                  %>
                    <option value="<%= category %>" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === category) ? 'selected' : '' %>><%= category %></option>
                  <% }) %>
                </select>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold" for="productSearch">Pesquisar produto</label>
                <input type="text" id="productSearch" name="search" class="form-control" placeholder="Nome ou descricao" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
              </div>

              <div class="col-md-3 d-flex gap-2">
                <button type="submit" formaction="/supermarket/<%= supermarket._id %>/products" formmethod="GET" id="btnApplyFilter" class="btn btn-primary flex-fill">Filtrar</button>
                <a href="/supermarket/<%= supermarket._id %>/products" id="clearProductSearch" class="btn btn-outline-secondary flex-fill">Limpar</a>
              </div>
            </div>

            <div class="row align-items-end mb-4">
              <div class="col-md-5">
                <label class="form-label fw-semibold text-primary" for="barcodeInput">Leitor de código de barras</label>
                <input type="text" id="barcodeInput" class="form-control border-primary" placeholder="Insira o EAN do produto e prima Enter">
              </div>
              
              <div class="col-md-7 d-flex justify-content-end gap-2">
                <a href="/supermarket/<%= supermarket._id %>" class="btn btn-outline-secondary">Cancelar</a>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#customerModal">Continuar para cliente</button>
              </div>
            </div>

            <div class="alert alert-success d-flex justify-content-between align-items-center mb-3">
              <span class="fs-5">Total da venda em tempo real:</span>
              <strong class="fs-4" id="liveTotal">€ 0.00</strong>
            </div>

            <div class="alert alert-light border mb-4">
              O total em tempo real mostra apenas os produtos selecionados. O custo de entrega e o cupão são validados ao confirmar a venda.
            </div>

            <div class="alert alert-info d-none" id="noProductsMatch">
              Não existem produtos a corresponder a esta pesquisa.
            </div>

            <div class="table-responsive">
              <table class="table align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Selecionar</th>
                    <th style="width: 70px;">Foto</th>
                    <th>Produto</th>
                    <th>Preço</th>
                    <th>Stock</th>
                    <th>Quantidade</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach((product, index) => { %>
                    <% const productId = product._id.toString(); %>
                    <% const selected = typeof selectedProductIds !== 'undefined' && selectedProductIds.includes(productId); %>
                    <% const quantity = (typeof quantities !== 'undefined' && quantities[productId]) || 1; %>
                    <% const outOfStock = product.stock <= 0; %>

                    <tr
                      data-product-row
                      data-product-id="<%= productId %>"
                      data-ean="<%= product.EAN || '' %>"
                      data-price="<%= product.price %>"
                      data-category="<%= product.category ? product.category.name : '' %>"
                      data-search="<%= [product.name, product.description || ''].join(' ').toLowerCase() %>"
                      class="<%= outOfStock ? 'table-secondary' : '' %>">

                      <td>
                        <input class="form-check-input" type="checkbox" name="items[<%= index %>][selected]" value="1" <%= selected ? "checked" : "" %> <%= outOfStock ? "disabled" : "" %>>
                        <input type="hidden" name="items[<%= index %>][productId]" value="<%= productId %>">
                      </td>

                      <td>
                        <% if (product.image && product.image !== "default-product.png") { %>
                          <img src="/uploads/products/<%= product.image %>" alt="<%= product.name %>" class="rounded shadow-sm border" style="width: 45px; height: 45px; object-fit: cover;">
                        <% } else { %>
                          <div class="bg-light d-flex align-items-center justify-content-center rounded border text-muted" style="width: 45px; height: 45px; font-size: 0.7rem;">Sem foto</div>
                        <% } %>
                      </td>

                      <td>
                        <div class="fw-semibold"><%= product.name %></div>
                        <% if (product.description) { %>
                          <div class="small text-muted"><%= product.description %></div>
                        <% } %>
                      </td>
                      <td>EUR <%= Number(product.price).toFixed(2) %></td>
                      <td>
                        <% if (outOfStock) { %>
                          <span class="badge bg-danger">Sem stock</span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success"><%= product.stock %></span>
                        <% } %>
                      </td>
                      <td style="max-width: 140px;">
                        <input type="number" class="form-control" name="items[<%= index %>][quantity]" min="1" max="<%= product.stock %>" value="<%= quantity %>" <%= outOfStock ? "disabled" : "" %>>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            
            <% if (typeof totalPages !== 'undefined') { %>
            <div class="d-flex justify-content-center align-items-center mt-4 mb-2">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&search=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>&category=<%= typeof selectedCategory !== 'undefined' ? selectedCategory : 'all' %>" class="btn btn-outline-secondary me-3">
                        &laquo; Página Anterior
                    </a>
                <% } else { %>
                    <button class="btn btn-outline-secondary me-3" disabled>
                        &laquo; Página Anterior
                    </button>
                <% } %>

                <span class="text-muted fw-bold">
                    Página <%= currentPage %> de <%= totalPages %>
                </span>

                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>&search=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>&category=<%= typeof selectedCategory !== 'undefined' ? selectedCategory : 'all' %>" class="btn btn-outline-primary ms-3">
                        Próxima Página &raquo;
                    </a>
                <% } else { %>
                    <button class="btn btn-outline-primary ms-3" disabled>
                        Próxima Página &raquo;
                    </button>
                <% } %>
            </div>
            <% } %>
            </div>
        </div>

        <div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
          <div class="modal-dialog modal-lg">
            <div class="modal-content">
              
              <div class="modal-header d-flex align-items-center">
                <h5 class="modal-title me-auto" id="customerModalLabel">Detalhes do cliente e entrega</h5>
                
                <div class="d-flex gap-2 me-3">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar aos produtos</button>
                  <button type="submit" class="btn btn-success">Confirmar e registar venda</button>
                </div>
                
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>

              <div class="modal-body">
                <div class="row g-4">
                  <div class="col-md-6">
                    <h6 class="mb-3 text-primary">Informação do Cliente</h6>
                    <div class="mb-4 d-flex justify-content-center">
                      <div class="btn-group" role="group">
                        <input type="radio" class="btn-check customer-type-radio" name="customerType" id="btnNew" value="novo" checked>
                        <label class="btn btn-outline-primary" for="btnNew">Cliente novo</label>
                        <input type="radio" class="btn-check customer-type-radio" name="customerType" id="btnExisting" value="existente">
                        <label class="btn btn-outline-primary" for="btnExisting">Cliente existente</label>
                      </div>
                    </div>

                    <div id="newCustomerZone">
                      <div class="mb-3">
                        <label class="form-label fw-semibold">Nome</label>
                        <input type="text" name="name" id="inputName" class="form-control" required value="<%= typeof customer !== 'undefined' && customer ? customer.name : '' %>">
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="email" id="inputEmail" class="form-control" required value="<%= typeof customer !== 'undefined' && customer ? customer.email : '' %>">
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-semibold">Morada</label>
                        <input type="text" name="address" id="inputAddress" class="form-control" required value="<%= typeof customer !== 'undefined' && customer ? customer.address : '' %>">
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-semibold">Telefone</label>
                        <input type="text" name="phone" id="inputPhone" class="form-control" required value="<%= typeof customer !== 'undefined' && customer ? customer.phone : '' %>">
                      </div>
                    </div>

                    <div id="existingCustomerZone" class="d-none">
                      <div class="mb-3">
                        <label class="form-label fw-semibold">Selecionar cliente</label>
                        <select name="existingCustomerId" id="selectExistingCustomer" class="form-select">
                          <option value="">Selecione um cliente...</option>
                          <% if (typeof customers !== "undefined") { %>
                            <% customers.forEach((customerOption) => { %>
                              <option value="<%= customerOption._id %>"><%= customerOption.name %> (<%= customerOption.phone || customerOption.telephone || "-" %>)</option>
                            <% }) %>
                          <% } %>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <h6 class="mb-3 text-primary">Detalhes da entrega</h6>
                    <div class="mb-3">
                      <label class="form-label fw-semibold">Método de entrega</label>
                      <select name="metodoEntrega" class="form-select" required>
                        <% supermarket.deliveryMethods.forEach((method) => { %>
                          <option value="<%= method %>" <%= (typeof deliveryMethod !== "undefined" && deliveryMethod === method) ? "selected" : "" %>><%= deliveryLabels[method] %></option>
                        <% }) %>
                      </select>
                    </div>

                    <div class="mb-3">
                      <label class="form-label fw-semibold">Código do cupão</label>
                      <input type="text" name="couponCode" class="form-control text-uppercase" placeholder="Opcional. Ex: BEMVINDO10" value="<%= typeof couponCode !== 'undefined' ? couponCode : '' %>">
                      <div class="form-text">Se indicar um cupão, o desconto será validado quando confirmar a venda.</div>
                    </div>

                    <div class="alert alert-info small">
                      Custo de entrega por estafeta:
                      <strong>EUR <%= Number(supermarket.deliveryCost || 0).toFixed(2) %></strong>
                    </div>
                  </div>
                </div>
              </div>
              
            </div>
          </div>
        </div>
      </form>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/scripts/createOrdersScript.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/scripts/createOrdersScript.js"></script>
  
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const cartKey = "cart_<%= supermarket._id %>";
      let cart = JSON.parse(sessionStorage.getItem(cartKey)) || {};

      function updateLiveTotal() {
        let total = 0;
        for (let id in cart) {
          total += cart[id].price * cart[id].quantity;
        }
        document.getElementById("liveTotal").innerText = "€ " + total.toFixed(2);
        sessionStorage.setItem(cartKey, JSON.stringify(cart));
      }


      document.querySelectorAll("tr[data-product-row]").forEach(row => {
        const id = row.dataset.productId;
        const checkbox = row.querySelector("input[type='checkbox']");
        const qtyInput = row.querySelector("input[type='number']");
        const price = parseFloat(row.dataset.price);

        if (cart[id]) {
          checkbox.checked = true;
          qtyInput.value = cart[id].quantity;
        }

        checkbox.addEventListener("change", function () {
          if (this.checked) {
            cart[id] = { price: price, quantity: parseInt(qtyInput.value) || 1 };
          } else {
            delete cart[id];
          }
          updateLiveTotal();
        });

        qtyInput.addEventListener("input", function () {
          if (checkbox.checked) {
            cart[id].quantity = parseInt(this.value) || 1;
            updateLiveTotal();
          }
        });
      });

      updateLiveTotal();


      const form = document.querySelector("form");
      form.addEventListener("submit", function (e) {

        if (e.submitter && e.submitter.id === "btnApplyFilter") return;

        document.querySelectorAll("tr[data-product-row] input").forEach(inp => inp.disabled = true);

        let index = 0;
        for (let id in cart) {
          form.insertAdjacentHTML("beforeend", `<input type="hidden" name="items[${index}][selected]" value="1">`);
          form.insertAdjacentHTML("beforeend", `<input type="hidden" name="items[${index}][productId]" value="${id}">`);
          form.insertAdjacentHTML("beforeend", `<input type="hidden" name="items[${index}][quantity]" value="${cart[id].quantity}">`);
          index++;
        }
        sessionStorage.removeItem(cartKey);
      });

      document.querySelectorAll("a.btn-outline-secondary").forEach(btn => {
        if (btn.innerText.includes("Cancelar")) {
          btn.addEventListener("click", () => sessionStorage.removeItem(cartKey));
        }
      });
    });
  </script>
  </body>
  
  </html>
  </body>
  
  </html>