<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Encomendas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%
    const statusClasses = {
      pendente: "bg-secondary",
      confirmada: "bg-primary",
      em_preparacao: "bg-warning text-dark",
      em_entrega: "bg-info text-dark",
      entregue: "bg-success",
      cancelada: "bg-danger",
    };
  %>

  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Encomendas e vendas</h1>
        <p class="text-muted mb-0">
          <% if (role === "estafeta") { %>
            Entregas disponiveis e entregas a teu cargo.
          <% } else { %>
            Historico de encomendas por supermercado.
          <% } %>
        </p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/supermarket/dashboard" class="btn btn-outline-primary">Dashboard</a>
        <a href="/supermarket/list" class="btn btn-outline-secondary">Supermercados</a>
      </div>
    </div>

    <% if (role !== "estafeta") { %>
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
          <form action="/orders" method="GET" class="row g-3 align-items-end">
            <div class="col-md-5">
              <label class="form-label fw-semibold">Supermercado</label>
              <select name="supermarketId" class="form-select">
                <option value="">Todos</option>
                <% supermarkets.forEach((supermarket) => { %>
                  <option
                    value="<%= supermarket._id %>"
                    <%= filters.supermarketId === String(supermarket._id) ? "selected" : "" %>>
                    <%= supermarket.name %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Estado</label>
              <select name="status" class="form-select">
                <option value="">Todos</option>
                <% Object.keys(statusLabels).forEach((statusKey) => { %>
                  <option value="<%= statusKey %>" <%= filters.status === statusKey ? "selected" : "" %>>
                    <%= statusLabels[statusKey] %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
              <a href="/orders" class="btn btn-outline-secondary flex-fill">Limpar</a>
            </div>
          </form>
        </div>
      </div>
    <% } %>

    <div class="card shadow-sm border-0">
      <div class="card-body">
        <% if (!orders.length) { %>
          <div class="alert alert-info mb-0">Nao foram encontradas encomendas para os filtros escolhidos.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead class="table-light">
                <tr>
                  <th>Data</th>
                  <th>Supermercado</th>
                  <th>Cliente</th>
                  <th>Entrega</th>
                  <th>Estado</th>
                  <th>Estafeta</th>
                  <th>Total</th>
                  <th class="text-end">Acoes</th>
                </tr>
              </thead>
              <tbody>
                <% orders.forEach((order) => { %>
                  <tr>
                    <td><%= new Date(order.createdAt).toLocaleString("pt-PT") %></td>
                    <td><%= order.supermercado ? order.supermercado.name : "-" %></td>
                    <td>
                      <div class="fw-semibold"><%= order.cliente ? order.cliente.name : "-" %></div>
                      <div class="small text-muted"><%= order.cliente ? order.cliente.email : "" %></div>
                    </td>
                    <td><%= deliveryLabels[order.metodoEntrega] %></td>
                    <td>
                      <span class="badge <%= statusClasses[order.estado] %>"><%= statusLabels[order.estado] %></span>
                    </td>
                    <td><%= order.estafeta ? order.estafeta.name : "-" %></td>
                    <td>EUR <%= Number(order.total).toFixed(2) %></td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-2 flex-wrap">
                        <% if (role === "estafeta" && order.metodoEntrega === "estafeta" && order.estado === "em_preparacao" && !order.estafeta) { %>
                          <form action="/orders/<%= order._id %>/claim" method="POST">
                            <button type="submit" class="btn btn-sm btn-primary">Aceitar</button>
                          </form>
                        <% } %>
                        <a href="/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary">Detalhe</a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
