<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Encomendas</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%
    const statusClasses = {
      pendente: "bg-secondary",
      confirmada: "bg-primary",
      em_preparacao: "bg-warning text-dark",
      em_entrega: "bg-info text-dark",
      entregue: "bg-success",
      cancelada: "bg-danger",
    };

    const showSupermarketFilter = role === "admin" || role === "supermercado";
  %>

  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <% if (role === "cliente") { %>
          <h1 class="mb-1">As minhas encomendas</h1>
          <p class="text-muted mb-0">Historico das encomendas feitas na plataforma.</p>
        <% } else { %>
          <h1 class="mb-1">Encomendas e vendas</h1>
          <p class="text-muted mb-0">
            <% if (role === "estafeta") { %>
              Entregas disponiveis, pedidos a aguardar preparacao e entregas a seu cargo.
            <% } else { %>
              Historico de encomendas por supermercado.
            <% } %>
          </p>
        <% } %>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="<%= dashboardPath %>" class="btn btn-outline-primary">Voltar ao dashboard</a>
        <% if (role === "cliente") { %>
          <a href="/supermarket/list" class="btn btn-outline-secondary">Supermercados</a>
        <% } else { %>
          <a href="/supermarket/list" class="btn btn-outline-secondary">Supermercados</a>
        <% } %>
      </div>
    </div>

    <% if (showSupermarketFilter || role === "cliente") { %>
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
          <form action="/orders" method="GET" class="row g-3 align-items-end">
            <% if (showSupermarketFilter) { %>
              <div class="col-md-5">
                <label class="form-label fw-semibold">Supermercado</label>
                <select name="supermarketId" class="form-select">
                  <option value="">Todos</option>
                  <% supermarkets.forEach((supermarket) => { %>
                    <option value="<%= supermarket._id %>" <%= filters.supermarketId === String(supermarket._id) ? "selected" : "" %>>
                      <%= supermarket.name %>
                    </option>
                  <% }) %>
                </select>
              </div>
            <% } %>
            <div class="<%= showSupermarketFilter ? 'col-md-4' : 'col-md-6' %>">
              <label class="form-label fw-semibold">Estado</label>
              <select name="status" class="form-select">
                <option value="">Todos</option>
                <% Object.keys(statusLabels).forEach((statusKey) => { %>
                  <option value="<%= statusKey %>" <%= filters.status === statusKey ? "selected" : "" %>>
                    <%= statusLabels[statusKey] %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="<%= showSupermarketFilter ? 'col-md-3' : 'col-md-6' %> d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
              <a href="/orders" class="btn btn-outline-secondary flex-fill">Limpar</a>
            </div>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-info shadow-sm border-0 mb-4">
        As encomendas com entrega por estafeta aparecem aqui logo apos serem confirmadas. O botao <strong>Aceitar</strong> so fica disponivel quando passam para <strong>Em preparacao</strong>.
      </div>
    <% } %>

    <div class="card shadow-sm border-0">
      <div class="card-body">
        <% if (!orders.length) { %>
          <div class="alert alert-info mb-0">Nao foram encontradas encomendas para os filtros escolhidos.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead class="table-light">
                <tr>
                  <th>Data</th>
                  <th>Supermercado</th>
                  <% if (role !== "cliente") { %>
                    <th>Cliente</th>
                  <% } %>
                  <th>Entrega</th>
                  <th>Estado</th>
                  <% if (role !== "cliente") { %>
                    <th>Estafeta</th>
                  <% } %>
                  <th>Total</th>
                  <th class="text-end">Acoes</th>
                </tr>
              </thead>
              <tbody>
                <% orders.forEach((order) => { %>
                  <%
                    const orderCourierId =
                      order.estafeta && order.estafeta._id
                        ? String(order.estafeta._id)
                        : order.estafeta
                        ? String(order.estafeta)
                        : null;
                  %>
                  <tr>
                    <td><%= new Date(order.createdAt).toLocaleString("pt-PT") %></td>
                    <td><%= order.supermercado ? order.supermercado.name : "-" %></td>
                    <% if (role !== "cliente") { %>
                      <td>
                        <div class="fw-semibold"><%= order.cliente ? order.cliente.name : "-" %></div>
                        <div class="small text-muted"><%= order.cliente ? order.cliente.email : "" %></div>
                      </td>
                    <% } %>
                    <td><%= deliveryLabels[order.metodoEntrega] || order.metodoEntrega %></td>
                    <td>
                      <span class="badge <%= statusClasses[order.estado] %>"><%= statusLabels[order.estado] %></span>
                      <% if (role === "estafeta" && order.metodoEntrega === "estafeta" && !order.estafeta && order.estado === "confirmada") { %>
                        <div class="small text-muted mt-1">A aguardar preparacao do supermercado</div>
                      <% } %>
                    </td>
                    <% if (role !== "cliente") { %>
                      <td>
                        <% if (order.estafetaDisplayName && order.estafetaDisplayName !== "-") { %>
                          <%= order.estafetaDisplayName %>
                        <% } else if (role === "estafeta" && order.estado === "em_preparacao") { %>
                          Disponivel
                        <% } else if (order.estado === "confirmada" && role === "estafeta") { %>
                          A aguardar preparacao
                        <% } else { %>
                          -
                        <% } %>
                      </td>
                    <% } %>
                    <td>EUR <%= Number(order.total).toFixed(2) %></td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-2 flex-wrap">
                        <% if (role === "estafeta" && order.metodoEntrega === "estafeta" && order.estado === "em_preparacao" && !order.estafeta && !courierHasDeliveryInProgress) { %>
                          <form action="/orders/<%= order._id %>/claim" method="POST">
                            <button type="submit" class="btn btn-sm btn-primary">Aceitar</button>
                          </form>
                        <% } %>
                        <a href="/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary">Detalhe</a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
