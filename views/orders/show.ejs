<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detalhe da Encomenda</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-light">
  <%
    const statusClasses = {
      pendente: "bg-secondary",
      confirmada: "bg-primary",
      em_preparacao: "bg-warning text-dark",
      em_entrega: "bg-info text-dark",
      entregue: "bg-success",
      cancelada: "bg-danger",
    };

    const paymentClasses = {
      pending: "bg-secondary",
      paid: "bg-success",
      failed: "bg-danger",
      canceled: "bg-warning text-dark",
    };
  %>

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="mb-1">Encomenda #<%= order._id.toString().slice(-6).toUpperCase() %></h1>
        <p class="text-muted mb-0">Criada em <%= new Date(order.createdAt).toLocaleString("pt-PT") %></p>
      </div>
      <div class="d-flex gap-2">
        <a href="/orders" class="btn btn-outline-primary">Voltar</a>
        <% if (role === "cliente") { %>
          <a href="/supermarket/list" class="btn btn-outline-secondary">Supermercados</a>
        <% } else { %>
          <a href="<%= dashboardPath %>" class="btn btn-outline-secondary">Dashboard</a>
        <% } %>
      </div>
    </div>

    <% if (role === "estafeta" && order.metodoEntrega === "estafeta" && !order.estafeta && order.estado === "confirmada") { %>
      <div class="alert alert-info shadow-sm border-0 mb-4">
        Esta entrega ja esta visivel para si, mas so pode ser aceite quando o supermercado a passar para <strong>Em preparacao</strong>.
      </div>
    <% } %>

    <% if (paymentMessage === "success") { %>
      <div class="alert alert-success shadow-sm border-0 mb-4">
        Pagamento confirmado com sucesso.
      </div>
    <% } else if (paymentMessage === "pending") { %>
      <div class="alert alert-warning shadow-sm border-0 mb-4">
        O pagamento ainda esta a ser confirmado pela Stripe.
      </div>
    <% } else if (paymentMessage === "canceled") { %>
      <div class="alert alert-secondary shadow-sm border-0 mb-4">
        O checkout foi cancelado. Pode tentar novamente quando quiser.
      </div>
    <% } else if (paymentMessage === "already_paid") { %>
      <div class="alert alert-info shadow-sm border-0 mb-4">
        Esta encomenda ja se encontra paga.
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h4 mb-0">Resumo da encomenda</h2>
              <span class="badge <%= statusClasses[order.estado] %> px-3 py-2">
                <%= statusLabels[order.estado] %>
              </span>
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <div class="small text-muted">Supermercado</div>
                <div class="fw-bold"><%= order.supermercado ? order.supermercado.name : "-" %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Metodo de entrega</div>
                <div class="fw-bold"><%= deliveryLabels[order.metodoEntrega] || order.metodoEntrega %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Cliente</div>
                <div class="fw-bold"><%= order.cliente ? order.cliente.name : "-" %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Email</div>
                <div class="fw-bold"><%= order.cliente ? order.cliente.email : "-" %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Telefone</div>
                <div class="fw-bold"><%= order.cliente ? (order.cliente.phone || order.cliente.telephone || "-") : "-" %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Estafeta</div>
                <div class="fw-bold"><%= order.estafetaDisplayName && order.estafetaDisplayName !== "-" ? order.estafetaDisplayName : "Nao atribuido" %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Cupao</div>
                <div class="fw-bold"><%= order.couponCode || "Sem cupao" %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Pagamento</div>
                <div>
                  <span class="badge <%= paymentClasses[order.paymentStatus || "pending"] %> px-3 py-2">
                    <%= paymentStatusLabels[order.paymentStatus || "pending"] %>
                  </span>
                </div>
              </div>
              <% if (order.paidAt) { %>
                <div class="col-md-6">
                  <div class="small text-muted">Pago em</div>
                  <div class="fw-bold"><%= new Date(order.paidAt).toLocaleString("pt-PT") %></div>
                </div>
              <% } %>
              <div class="col-12">
                <div class="small text-muted">Morada de entrega</div>
                <div class="fw-bold"><%= order.cliente ? order.cliente.address : "Levantamento em loja" %></div>
              </div>
            </div>
          </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            <h2 class="h4 mb-3">Produtos</h2>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Produto</th>
                    <th class="text-center">Qtd</th>
                    <th class="text-end">Preco un.</th>
                    <th class="text-end">Subtotal</th>
                  </tr>
                </thead>
                <tbody>
                  <% order.items.forEach((item) => { %>
                    <tr>
                      <td><%= item.nome %></td>
                      <td class="text-center"><%= item.quantidade %></td>
                      <td class="text-end">EUR <%= Number(item.precoUnitario).toFixed(2) %></td>
                      <td class="text-end fw-bold">EUR <%= Number(item.subtotal).toFixed(2) %></td>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot class="table-group-divider">
                  <tr>
                    <td colspan="3" class="text-end text-muted">Subtotal dos produtos:</td>
                    <td class="text-end text-muted">EUR <%= Number(order.subtotalProdutos || order.total || 0).toFixed(2) %></td>
                  </tr>
                  <tr>
                    <td colspan="3" class="text-end text-muted">Custo de entrega:</td>
                    <td class="text-end text-muted">EUR <%= Number(order.custoEntrega || 0).toFixed(2) %></td>
                  </tr>
                  <% if (order.discountApplied && order.discountApplied > 0) { %>
                    <tr>
                      <td colspan="3" class="text-end text-success">Desconto (<%= order.couponCode || "cupao" %>):</td>
                      <td class="text-end text-success">- EUR <%= Number(order.discountApplied || 0).toFixed(2) %></td>
                    </tr>
                  <% } %>
                  <tr class="fs-5">
                    <td colspan="3" class="text-end fw-bold">Total:</td>
                    <td class="text-end fw-bold text-primary">EUR <%= Number(order.total).toFixed(2) %></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card shadow-sm border-0 sticky-top" style="top: 2rem;">
          <div class="card-body">
            <h2 class="h4 mb-3">Operacoes</h2>

            <% if (["cliente", "supermercado", "admin"].includes(role) && order.paymentStatus !== "paid" && order.estado !== "cancelada") { %>
              <form action="/payments/checkout/<%= order._id %>" method="POST" class="mb-3">
                <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                  Pagar com Stripe
                </button>
              </form>
            <% } %>

            <% if (role === "estafeta" && order.metodoEntrega === "estafeta" && order.estado === "em_preparacao" && !order.estafeta && !courierHasDeliveryInProgress) { %>
              <form action="/orders/<%= order._id %>/claim" method="POST" class="mb-3">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Aceitar entrega</button>
              </form>
            <% } else if (role === "estafeta" && order.metodoEntrega === "estafeta" && order.estado === "em_preparacao" && !order.estafeta && courierHasDeliveryInProgress) { %>
              <div class="alert alert-warning">
                Ja tem uma entrega em curso. Termine-a antes de aceitar outra.
              </div>
            <% } %>

            <% if (allowedTransitions.length) { %>
              <div class="d-grid gap-2">
                <% allowedTransitions.forEach((nextStatus) => { %>
                  <form action="/orders/<%= order._id %>/status" method="POST">
                    <input type="hidden" name="estado" value="<%= nextStatus %>">
                    <button type="submit" class="btn w-100 py-2 <%= nextStatus === 'cancelada' ? 'btn-outline-danger' : 'btn-outline-primary' %>">
                      Marcar como <%= statusLabels[nextStatus] %>
                    </button>
                  </form>
                <% }) %>
              </div>
            <% } else { %>
              <div class="alert alert-light border text-center mb-0">
                Nao existem acoes disponiveis para esta encomenda no momento.
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <% if (order.estado === "entregue" && role === "cliente" && (!order.avaliacaoSupermercado || !order.avaliacaoSupermercado.rating)) { %>
      <div class="card shadow-sm border-0 mt-4 bg-white border-start border-4 border-success">
        <div class="card-body p-4">
          <h3 class="h4 mb-4 text-success">Avalie a sua experiencia</h3>
          <form action="/orders/<%= order._id %>/rate" method="POST">
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Supermercado</label>
                <select name="ratingSupermarket" class="form-select mb-2" required>
                  <option value="5">5 estrelas - Excelente</option>
                  <option value="4">4 estrelas - Muito bom</option>
                  <option value="3" selected>3 estrelas - Bom</option>
                  <option value="2">2 estrelas - Razoavel</option>
                  <option value="1">1 estrela - Mau</option>
                </select>
                <textarea name="commentSupermarket" class="form-control" rows="2" placeholder="Comentario sobre os produtos..."></textarea>
              </div>
              <% if (order.metodoEntrega === "estafeta" && order.estafeta) { %>
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">Estafeta</label>
                  <select name="ratingCourier" class="form-select mb-2" required>
                    <option value="5">5 estrelas - Rapido e gentil</option>
                    <option value="4">4 estrelas - Bom servico</option>
                    <option value="3" selected>3 estrelas - Normal</option>
                    <option value="2">2 estrelas - Atrasado</option>
                    <option value="1">1 estrela - Muito mau</option>
                  </select>
                  <textarea name="commentCourier" class="form-control" rows="2" placeholder="Comentario sobre a entrega..."></textarea>
                </div>
              <% } %>
            </div>
            <button type="submit" class="btn btn-success w-100 fw-bold">Submeter avaliacao</button>
          </form>
        </div>
      </div>
    <% } %>

    <% if (order.avaliacaoSupermercado && order.avaliacaoSupermercado.rating) { %>
      <div class="card shadow-sm border-0 mt-4">
        <div class="card-body p-4">
          <h3 class="h4 mb-3">A sua avaliacao</h3>
          <div class="row">
            <div class="col-md-6">
              <p class="mb-1 fw-bold">Supermercado:</p>
              <div class="mb-2">
                <% for (let i = 0; i < 5; i += 1) { %>
                  <span class="<%= i < order.avaliacaoSupermercado.rating ? 'text-warning' : 'text-muted' %> fs-5">★</span>
                <% } %>
              </div>
              <p class="text-muted small">"<%= order.avaliacaoSupermercado.comentario || 'Sem comentario.' %>"</p>
            </div>
            <% if (order.avaliacaoEstafeta && order.avaliacaoEstafeta.rating) { %>
              <div class="col-md-6 border-start">
                <p class="mb-1 fw-bold">Estafeta:</p>
                <div class="mb-2">
                  <% for (let i = 0; i < 5; i += 1) { %>
                    <span class="<%= i < order.avaliacaoEstafeta.rating ? 'text-warning' : 'text-muted' %> fs-5">★</span>
                  <% } %>
                </div>
                <p class="text-muted small">"<%= order.avaliacaoEstafeta.comentario || 'Sem comentario.' %>"</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
