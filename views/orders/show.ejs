<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detalhe da Encomenda</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%
    const statusClasses = {
      pendente: "bg-secondary",
      confirmada: "bg-primary",
      em_preparacao: "bg-warning text-dark",
      em_entrega: "bg-info text-dark",
      entregue: "bg-success",
      cancelada: "bg-danger",
    };
  %>

  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Encomenda</h1>
        <p class="text-muted mb-0">
          Criada em <%= new Date(order.createdAt).toLocaleString("pt-PT") %>
        </p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/orders" class="btn btn-outline-primary">Voltar a encomendas</a>
        <a href="/supermarket/<%= order.supermercado._id %>" class="btn btn-outline-secondary">Voltar ao supermercado</a>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h4 mb-0">Resumo</h2>
              <span class="badge <%= statusClasses[order.estado] %>"><%= statusLabels[order.estado] %></span>
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <div class="small text-muted">Supermercado</div>
                <div class="fw-semibold"><%= order.supermercado.name %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Método de entrega</div>
                <div class="fw-semibold"><%= deliveryLabels[order.metodoEntrega] %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Cliente</div>
                <div class="fw-semibold"><%= order.cliente.name %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Email</div>
                <div class="fw-semibold"><%= order.cliente.email %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Telefone</div>
                <div class="fw-semibold"><%= order.cliente.phone || order.cliente.telephone || "-" %></div>
              </div>
              <div class="col-md-6">
                <div class="small text-muted">Estafeta</div>
                <div class="fw-semibold"><%= order.estafeta ? order.estafeta.name : "Nao atribuido" %></div>
              </div>
              <div class="col-12">
                <div class="small text-muted">Morada</div>
                <div class="fw-semibold"><%= order.cliente.address %></div>
              </div>
            </div>
          </div>
        </div>

        <div class="card shadow-sm border-0">
          <div class="card-body">
            <h2 class="h4 mb-3">Itens da venda</h2>

            <div class="table-responsive">
              <table class="table align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Produto</th>
                    <th>Quantidade</th>
                    <th>Preço unitário</th>
                    <th>Subtotal</th>
                  </tr>
                </thead>
                <tbody>
                  <% order.items.forEach((item) => { %>
                    <tr>
                      <td>
                        <div class="fw-semibold"><%= item.nome %></div>
                        <% if (item.product && item.product.description) { %>
                          <div class="small text-muted"><%= item.product.description %></div>
                        <% } %>
                      </td>
                      <td><%= item.quantidade %></td>
                      <td>EUR <%= Number(item.precoUnitario).toFixed(2) %></td>
                      <td>EUR <%= Number(item.subtotal).toFixed(2) %></td>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot>
                  <tr>
                    <th colspan="3" class="text-end">Custo de entrega</th>
                    <th>EUR <%= Number(order.custoEntrega || 0).toFixed(2) %></th>
                  </tr>
                  <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th>EUR <%= Number(order.total).toFixed(2) %></th>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card shadow-sm border-0">
          <div class="card-body">
            <h2 class="h4 mb-3">Operações</h2>

            <% if (role === "estafeta" && order.metodoEntrega === "estafeta" && order.estado === "em_preparacao" && !order.estafeta) { %>
              <form action="/orders/<%= order._id %>/claim" method="POST" class="mb-3">
                <button type="submit" class="btn btn-primary w-100">Aceitar entrega</button>
              </form>
            <% } %>

            <% if (allowedTransitions.length) { %>
              <div class="d-grid gap-2">
                <% allowedTransitions.forEach((nextStatus) => { %>
                  <form action="/orders/<%= order._id %>/status" method="POST">
                    <input type="hidden" name="estado" value="<%= nextStatus %>">
                    <button
                      type="submit"
                      class="btn w-100 <%= nextStatus === 'cancelada' ? 'btn-outline-danger' : 'btn-outline-primary' %>">
                      Marcar como <%= statusLabels[nextStatus] %>
                    </button>
                  </form>
                <% }) %>
              </div>
            <% } else { %>
              <div class="alert alert-secondary mb-0">
                Não há transições disponíveis para o seu perfil neste estado.
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
