<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Editar Produto</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <h1>Editar: <%= product.name %></h1>
    
    <form action="/supermarket/<%= supermarket._id %>/products/<%= product._id %>/edit" method="POST" class="mt-4">
        <div class="mb-3">
            <label>Nome:</label>
            <input type="text" name="name" class="form-control" value="<%= product.name %>" required>
        </div>

        <div class="mb-3">
            <label>Descrição:</label>
            <textarea name="description" class="form-control" rows="3"><%= product.description %></textarea>
        </div>

        <div class="mb-3">
            <label>Categoria:</label>
            <select name="category" class="form-select" required>
                <% categories.forEach(cat => { %>
                    <option value="<%= cat._id %>" <%= product.category && product.category.toString() === cat._id.toString() ? 'selected' : '' %>>
                        <%= cat.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="mb-3">
            <label>URL da Imagem:</label>
            <input type="text" name="image" class="form-control" value="<%= product.image %>">
        </div>

        <div class="row">
            <div class="col mb-3">
                <label>Preço (€):</label>
                <input type="number" step="0.01" name="price" class="form-control" value="<%= product.price %>" required>
            </div>
            <div class="col mb-3">
                <label>Stock:</label>
                <input type="number" name="stock" class="form-control" value="<%= product.stock %>" required>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Atualizar</button>
        <a href="/supermarket/<%= supermarket._id %>/products" class="btn btn-secondary">Cancelar</a>
    </form>
</body>
</html>