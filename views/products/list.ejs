<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Produtos - <%= supermarket.name %></title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Produtos</h1>
        <p class="text-muted mb-0"><%= supermarket.name %></p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/supermarket/list" class="btn btn-outline-secondary">Voltar à lista</a>
        <a href="/supermarket/<%= supermarket._id %>" class="btn btn-outline-info">Voltar ao detalhe</a>
        <% if (supermarket.isApproved && (userRole === "supermercado" || userRole === "admin")) { %>
          <a href="/orders/create/<%= supermarket._id %>" class="btn btn-primary">Registar venda</a>
          <a href="/orders?supermarketId=<%= supermarket._id %>" class="btn btn-outline-dark">Ver encomendas</a>
        <% } %>
      </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <form action="/supermarket/<%= supermarket._id %>/products" method="GET" class="row g-3 align-items-end">

          <div class="col-md-5">
            <label class="form-label fw-semibold">Categoria</label>
            <select name="category" class="form-select">
              <option value="all" <%= (typeof selectedCategory === 'undefined' || selectedCategory === 'all') ? 'selected' : '' %>>Todas</option>
              <% if (typeof categories !== 'undefined') { %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat._id %>" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === String(cat._id)) ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label fw-semibold">Pesquisar produto</label>
            <input type="text" name="search" class="form-control" placeholder="Nome ou descrição"
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
          </div>

          <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
            <a href="/supermarket/<%= supermarket._id %>/products" class="btn btn-outline-secondary flex-fill">Limpar</a>
          </div>

        </form>
      </div>
    </div>

    <% if (userRole === "supermercado" || userRole === "admin") { %>
      <% if (supermarket.isApproved) { %>
        <div class="mb-3">
          <a href="/supermarket/<%= supermarket._id %>/products/new" class="btn btn-success">Adicionar produto</a>
        </div>
      <% } else { %>
        <div class="alert alert-danger">Supermercado não aprovado. Não pode gerir produtos!</div>
      <% } %>
    <% } %>

    <div class="card shadow-sm border-0">
      <div class="card-body">
        <% if (!products || products.length === 0) { %>
          <div class="alert alert-info mb-0">Não existem produtos para mostrar!</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle table-hover">
              <thead class="table-light">
                <tr>
                  <th style="width: 80px;">Foto</th>
                  <th>Nome</th>
                  <th>Categoria</th>
                  <th>Preço</th>
                  <th>Stock</th>
                  <th class="text-end">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach(function(product) { %>
                  <tr>
                    <td>
                      <% if (product.image && product.image !== 'default-product.png') { %>
                        <img src="/uploads/products/<%= product.image %>" 
                             alt="<%= product.name %>" 
                             class="rounded shadow-sm border" 
                             style="width: 50px; height: 50px; object-fit: cover;">
                      <% } else { %>
                        <div class="bg-light d-flex align-items-center justify-content-center rounded border" 
                             style="width: 50px; height: 50px;">
                          <small class="text-muted" style="font-size: 10px;">Sem foto</small>
                        </div>
                      <% } %>
                    </td>
                    <td>
                      <div class="fw-bold"><%= product.name %></div>
                      <div class="small text-muted"><%= product.description %></div>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border">
                        <%= product.category ? product.category.name : 'Sem categoria' %>
                      </span>
                    </td>
                    <td class="fw-semibold">EUR <%= Number(product.price).toFixed(2) %></td>
                    <td>
                      <span class="badge <%= product.stock > 0 ? 'bg-success' : 'bg-danger' %>">
                        <%= product.stock %>
                      </span>
                    </td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-2">
                        <% if (userRole === "supermercado" || userRole === "admin") { %>
                          <a href="/supermarket/<%= supermarket._id %>/products/<%= product._id %>/edit" class="btn btn-sm btn-warning">Editar</a>
                          <form action="/supermarket/<%= supermarket._id %>/products/<%= product._id %>/delete" method="POST" onsubmit="return confirm('Tem a certeza?')">
                            <button type="submit" class="btn btn-sm btn-danger">Apagar</button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>