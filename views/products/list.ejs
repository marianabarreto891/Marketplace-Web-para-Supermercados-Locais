<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Produtos - <%= supermarket.name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <h1>Produtos: <%= supermarket.name %></h1>
    
    <div class="mb-4 mt-2">
        <a href="/supermarket/list" class="btn btn-outline-secondary">&larr; Voltar à Lista de Supermercados</a>
        <a href="/supermarket/<%= supermarket._id %>" class="btn btn-outline-info">&larr; Voltar ao Detalhe do Supermercado</a>
    </div>

    <form action="/supermarket/<%= supermarket._id %>/products" method="GET" class="d-flex gap-2 mb-4">
        <input type="text" name="search" class="form-control w-25" placeholder="Pesquisar..." value="<%= searchQuery || '' %>">
        <button type="submit" class="btn btn-primary">Pesquisar</button>
        <a href="/supermarket/<%= supermarket._id %>/products" class="btn btn-secondary">Limpar</a>
    </form>

    <% if (userRole === 'supermercado' || userRole === 'admin') { %>
        <% if (supermarket.isApproved) { %>
            <a href="/supermarket/<%= supermarket._id %>/products/new" class="btn btn-success mb-3">Adicionar Produto</a>
        <% } else { %>
            <div class="alert alert-danger">Supermercado não aprovado. Não pode gerir produtos.</div>
        <% } %>
    <% } %>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Stock</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(p => { %>
                <tr>
                    <td><%= p.name %></td>
                    <td><%= p.category ? p.category.name : 'Sem Categoria' %></td>
                    <td>€<%= p.price %></td>
                    <td><%= p.stock %></td>
                    <td>
                        <% if (supermarket.isApproved && (userRole === 'supermercado' || userRole === 'admin')) { %>
                            <a href="/supermarket/<%= supermarket._id %>/products/<%= p._id %>/edit" class="btn btn-sm btn-warning">Editar</a>
                            <form action="/supermarket/<%= supermarket._id %>/products/<%= p._id %>/delete" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger">Apagar</button>
                            </form>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>