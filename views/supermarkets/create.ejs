<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar Supermercado</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <h1>Registar Novo Supermercado</h1>
    
    <form action="/supermarket/new" method="POST" class="mt-4">
        
        <div class="mb-3">
            <label class="form-label">Nome do Supermercado:</label>
            <input type="text" name="name" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Descrição:</label>
            <textarea name="description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Localização:</label>
            <input type="text" name="location" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Horário de Funcionamento:</label>
            <input type="text" name="hours" class="form-control" placeholder="Ex: 09:00 - 20:00">
        </div>

        <div class="mb-3">
            <label class="form-label">Métodos de Entrega (Selecione pelo menos um):</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="deliveryMethods" value="levantamento_loja">
                <label class="form-check-label">Levantamento em Loja</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="deliveryMethods" value="estafeta">
                <label class="form-check-label">Entrega por Estafeta</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Custo de Entrega por Estafeta (€):</label>
            <input type="number" step="0.01" name="deliveryCost" class="form-control" value="0" min="0">
        </div>

        <button type="submit" class="btn btn-success">Registar Supermercado</button>
        <a href="/supermarket/list" class="btn btn-secondary">Cancelar</a>
    </form>
</body>
</html>