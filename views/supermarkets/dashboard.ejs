<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard do Supermercado</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%
    const statusClasses = {
      pendente: "bg-secondary",
      confirmada: "bg-primary",
      em_preparacao: "bg-warning text-dark",
      em_entrega: "bg-info text-dark",
      entregue: "bg-success",
      cancelada: "bg-danger",
    };
  %>

  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Dashboard do supermercado</h1>
        <p class="text-muted mb-0">Resumo de encomendas, vendas e produtos mais vendidos.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/orders" class="btn btn-primary">Ver encomendas</a>
        <a href="/supermarket/list" class="btn btn-outline-secondary">Supermercados</a>
        <a href="/users/logout" class="btn btn-danger">Terminar sessao</a>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Numero de encomendas</div>
            <div class="display-6 fw-bold"><%= summary.totalOrders %></div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Encomendas ativas</div>
            <div class="display-6 fw-bold"><%= summary.openOrders %></div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Produtos vendidos</div>
            <div class="display-6 fw-bold"><%= summary.totalUnitsSold %></div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Total vendido</div>
            <div class="display-6 fw-bold">EUR <%= Number(summary.totalRevenue).toFixed(2) %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h4 mb-0">Produtos mais vendidos</h2>
              <span class="badge bg-secondary">Total: <%= topProducts.length %></span>
            </div>

            <% if (!topProducts.length) { %>
              <div class="alert alert-info mb-0">Ainda nao existem vendas suficientes para mostrar os produtos mais vendidos.</div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Produto</th>
                      <th>Unidades</th>
                      <th>Encomendas</th>
                      <th>Total</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% topProducts.forEach((product) => { %>
                      <tr>
                        <td class="fw-semibold"><%= product.name %></td>
                        <td><%= product.unitsSold %></td>
                        <td><%= product.ordersCount %></td>
                        <td>EUR <%= Number(product.revenue).toFixed(2) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h4 mb-0">Supermercados geridos</h2>
              <a href="/supermarket/new" class="btn btn-outline-primary btn-sm">Adicionar</a>
            </div>

            <% if (!supermarkets.length) { %>
              <div class="alert alert-info mb-0">Ainda nao existem supermercados registados.</div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Nome</th>
                      <th>Estado</th>
                      <th class="text-end">Acoes</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% supermarkets.forEach((supermarket) => { %>
                      <tr>
                        <td>
                          <div class="fw-semibold"><%= supermarket.name %></div>
                          <div class="small text-muted"><%= supermarket.location %></div>
                        </td>
                        <td>
                          <span class="badge <%= !supermarket.toApprove ? 'bg-warning text-dark' : supermarket.isApproved ? 'bg-success' : 'bg-danger' %>">
                            <%= !supermarket.toApprove ? 'Pendente' : supermarket.isApproved ? 'Aprovado' : 'Rejeitado' %>
                          </span>
                        </td>
                        <td class="text-end">
                          <a href="/supermarket/<%= supermarket._id %>" class="btn btn-sm btn-outline-secondary">Detalhe</a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 mb-0">Ultimas encomendas</h2>
          <a href="/orders" class="btn btn-outline-primary btn-sm">Abrir listagem</a>
        </div>

        <% if (!recentOrders.length) { %>
          <div class="alert alert-info mb-0">Ainda nao existem registos para mostrar.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead class="table-light">
                <tr>
                  <th>Data</th>
                  <th>Supermercado</th>
                  <th>Cliente</th>
                  <th>Entrega</th>
                  <th>Estado</th>
                  <th>Estafeta</th>
                  <th>Total</th>
                  <th class="text-end">Acoes</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach((order) => { %>
                  <tr>
                    <td><%= new Date(order.createdAt).toLocaleString("pt-PT") %></td>
                    <td><%= order.supermercado ? order.supermercado.name : "-" %></td>
                    <td><%= order.cliente ? order.cliente.name : "-" %></td>
                    <td><%= deliveryLabels[order.metodoEntrega] || order.metodoEntrega %></td>
                    <td>
                      <span class="badge <%= statusClasses[order.estado] %>"><%= statusLabels[order.estado] %></span>
                    </td>
                    <td><%= order.estafetaDisplayName || "-" %></td>
                    <td>EUR <%= Number(order.total).toFixed(2) %></td>
                    <td class="text-end">
                      <a href="/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary">Detalhe</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
