<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Supermercado</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <h1>Editar: <%= supermarket.name %></h1>
    
    <form action="/supermarket/<%= supermarket._id %>/edit" method="POST" class="mt-4">
        <div class="mb-3">
            <label class="form-label">Nome do Supermercado:</label>
            <input type="text" name="name" class="form-control" value="<%= supermarket.name %>" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Descrição:</label>
            <textarea name="description" class="form-control"><%= supermarket.description %></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Localização:</label>
            <input type="text" name="location" class="form-control" value="<%= supermarket.location %>" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Latitude:</label>
            <input type="number" step="0.000001" name="lat" class="form-control" value="<%= supermarket.lat %>" required>   
        </div>

        <div class="mb-3">
            <label class="form-label">Longitude:</label>
            <input type="number" step="0.000001" name="lon" class="form-control" value="<%= supermarket.lon %>" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Horário de Funcionamento:</label>
            <input type="text" name="hours" class="form-control" value="<%= supermarket.hours %>">
        </div>

        <div class="mb-3">
            <label class="form-label">Métodos de Entrega:</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="deliveryMethods" value="levantamento_loja" 
                    <%= supermarket.deliveryMethods.includes('levantamento_loja') ? 'checked' : '' %>>
                <label class="form-check-label">Levantamento em Loja</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="deliveryMethods" value="estafeta"
                    <%= supermarket.deliveryMethods.includes('estafeta') ? 'checked' : '' %>>
                <label class="form-check-label">Entrega por Estafeta</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Custo de Entrega por Estafeta (€):</label>
            <input type="number" step="0.01" name="deliveryCost" class="form-control" value="<%= supermarket.deliveryCost %>" min="0">
        </div>

        <button type="submit" class="btn btn-primary">Guardar Alterações</button>
        <a href="/supermarket/<%= supermarket._id %>" class="btn btn-secondary">Cancelar</a>
    </form>
</body>
</html>