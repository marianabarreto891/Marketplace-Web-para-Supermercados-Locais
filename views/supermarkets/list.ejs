<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de Supermercados</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div>
        <h1 class="mb-1">Supermercados registados</h1>
        <p class="text-muted mb-0">Acesso aos supermercados e ao backoffice operacional.</p>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <% if (userRole === "admin") { %>
          <a href="/admin/dashboard" class="btn btn-outline-primary">Dashboard admin</a>
        <% } %>
        <% if (userRole === "supermercado" || userRole === "estafeta") { %>
          <a href="/supermarket/dashboard" class="btn btn-outline-primary">Dashboard operacional</a>
        <% } %>
        <% if (userRole === "supermercado" || userRole === "admin") { %>
          <a href="/supermarket/new" class="btn btn-primary">Criar novo supermercado</a>
        <% } %>
        <% if (userRole) { %>
          <a href="/users/logout" class="btn btn-danger">Terminar sessao</a>
        <% } %>
      </div>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table align-middle">
            <thead class="table-light">
              <tr>
                <th>Nome</th>
                <th>Localizacao</th>
                <th>Estado</th>
                <th class="text-end">Acoes</th>
              </tr>
            </thead>
            <tbody>
              <% supermarkets.forEach((supermarket) => { %>
                <tr>
                  <td class="fw-semibold"><%= supermarket.name %></td>
                  <td><%= supermarket.location %></td>
                  <td>
                    <span class="badge <%= !supermarket.toApprove ? 'bg-warning text-dark' : supermarket.isApproved ? 'bg-success' : 'bg-danger' %>">
                      <%= !supermarket.toApprove ? 'Pendente' : supermarket.isApproved ? 'Aprovado' : 'Rejeitado' %>
                    </span>
                  </td>
                  <td class="text-end">
                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                      <a href="/supermarket/<%= supermarket._id %>" class="btn btn-sm btn-outline-info">Detalhes</a>

                      <% if (userRole === "admin" || (userRole === "supermercado" && supermarket.manager && supermarket.manager._id.toString() === userId)) { %>
                        <a href="/supermarket/<%= supermarket._id %>/edit" class="btn btn-sm btn-warning">Editar</a>
                        <a href="/orders?supermarketId=<%= supermarket._id %>" class="btn btn-sm btn-outline-dark">Encomendas</a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
