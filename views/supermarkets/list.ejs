<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Supermercados</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-5">
    <h1 class="mb-4">Supermercados Registados</h1>

    <% if (typeof userRole !=='undefined' && (userRole==='supermercado' || userRole==='admin' )) { %>
        <a href="/supermarket/new" class="btn btn-primary mb-3">Criar Novo Supermercado</a>
        <% } %>

            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Localização</th>
                        <th>Aprovado?</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% supermarkets.forEach(function(supermarket) { %>
                        <tr>
                            <td>
                                <%= supermarket.name %>
                            </td>
                            <td>
                                <%= supermarket.location %>
                            </td>
                            <td>
                                <span
                                    class="badge <%= supermarket.isApproved ? 'bg-success' : 'bg-warning text-dark' %>">
                                    <%= supermarket.isApproved ? 'Sim' : 'Pendente' %>
                                </span>
                            </td>
                            <td>
                                <a href="/supermarket/<%= supermarket._id %>" class="btn btn-sm btn-info">Ver
                                    Detalhes</a>

                                <% if (typeof userRole !=='undefined' && (userRole==='admin' ||
                                    (userRole==='supermercado' && supermarket.manager._id.toString()===userId))) { %>
                                    <a href="/supermarket/<%= supermarket._id %>/edit"
                                        class="btn btn-sm btn-warning">Editar</a>
                                    <% } %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
</body>

</html>