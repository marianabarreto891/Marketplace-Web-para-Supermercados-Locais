<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes do Supermercado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0"><%= supermarket.name %></h2>
            <span class="badge bg-light text-dark"><%= supermarket.isApproved ? 'Aprovado' : 'Aguardando Aprovação' %></span>
        </div>
        <div class="card-body">
            <p><strong>Gestor:</strong> <%= supermarket.manager.name %> (<%= supermarket.manager.email %>)</p>
            <p><strong>Descrição:</strong> <%= supermarket.description %></p>
            <p><strong>Localização:</strong> <%= supermarket.location %></p>
            <p><strong>Horário:</strong> <%= supermarket.hours %></p>
            <p><strong>Métodos de Entrega:</strong> 
                <%= supermarket.deliveryMethods.map(m => m === 'levantamento_loja' ? 'Levantamento em Loja' : 'Estafeta').join(', ') %>
            </p>
            <p><strong>Custo de Entrega:</strong> <%= supermarket.deliveryCost %> €</p>
            
            <hr>
            <h4>Ações Rápidas</h4>
            <a href="/supermarket/<%= supermarket._id %>/edit" class="btn btn-warning">Editar Supermercado</a>
            <a href="/supermarket/<%= supermarket._id %>/products" class="btn btn-info text-white">Ver Produtos</a>
            <a href="/supermarket/<%= supermarket._id %>/products/new" class="btn btn-success">Adicionar Produto</a>
        </div>
    </div>
    <div class="mt-3">
        <a href="/supermarket/list" class="btn btn-outline-secondary">Voltar à Lista</a>
    </div>
</body>
</html>