<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Detalhes do Supermercado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <div class="card shadow-sm p-4">
        <h1 class="mb-3"><%= supermarket.name %></h1>
        <p><strong>Descrição:</strong> <%= supermarket.description || 'N/A' %></p>
        <p><strong>Localização:</strong> <%= supermarket.location %></p>
        <p><strong>Horário:</strong> <%= supermarket.hours || 'N/A' %></p>
        <p><strong>Estado:</strong> 
            <span class="badge <%= supermarket.isApproved ? 'bg-success' : 'bg-warning text-dark' %>">
                <%= supermarket.isApproved ? 'Aprovado' : 'Pendente' %>
            </span>
        </p>

        <div class="mt-4">
            <a href="/supermarket/<%= supermarket._id %>/products" class="btn btn-primary">Ver Produtos</a>
            <a href="/supermarket/list" class="btn btn-secondary">Voltar à Lista</a>
        </div>
    </div>
</body>
</html>