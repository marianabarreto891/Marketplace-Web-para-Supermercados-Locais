<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Marketplace</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex align-items-center py-4" style="min-height: 100vh;">

    <main class="form-signin w-100 m-auto" style="max-width: 400px;">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Bem-vindo de volta</h2>
                    <p class="text-muted">Inicie sessão para continuar</p>
                </div>

                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <div class="alert alert-danger text-center" role="alert">
                        <%= errorMessage %>
                    </div>
                <% } %>

                <form action="/users/login" method="POST">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="floatingInput" name="email" placeholder="nome@exemplo.com" required>
                        <label for="floatingInput">E-mail ou nome de utilizador</label>
                    </div>

                    <div class="form-floating mb-2">
                        <input type="password" class="form-control" id="Password" name="password" placeholder="Password" required>
                        <label for="floatingPassword">Password</label>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="showPassword">
                        <label class="form-check-label small text-muted" for="showPassword">Mostrar password</label>
                        </label>
                    </div>

                    <button class="w-100 btn btn-lg btn-success mb-3" type="submit">Entrar</button>
                </form>

                <div class="text-center">
                    <span class="text-muted">Não tem conta?</span>
                    <a href="/users/register" class="text-decoration-none fw-bold">Registe-se aqui</a>
                </div>
                <div class="text-center mt-3">
                    <a href="/" class="text-muted text-decoration-none small">&larr; Voltar à página inicial</a>
                </div>
            </div>
        </div>
    </main>

    <script>
        const showPassword = document.getElementById('showPassword');
        const passwordInput = document.getElementById('Password');

        showPassword.addEventListener('change', function() {
            if (this.checked) {
                passwordInput.type = 'text';
            } else {    
                passwordInput.type = 'password';
            }
        });
    </script>
</body>
</html>