<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registo - Marketplace</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
    </style>
</head>
<body class="d-flex align-items-center py-4" style="min-height: 100vh;">
    
    <main class="w-100 m-auto" style="max-width: 600px;">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Criar Nova Conta</h2>
                    <p class="text-muted">Junte-se ao nosso Marketplace Local</p>
                </div>

                <form action="/users/register" method="POST">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Nome Completo / Nome da Loja</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">E-mail</label>
                            <input type="email" name="email" class="form-control" placeholder="nome@exemplo.com" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Password</label>
                            <input type="password" name="password" class="form-control" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Morada</label>
                            <input type="text" name="address" class="form-control" placeholder="Rua, Número, Código Postal..." required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Telefone</label>
                            <input type="text" name="phone" class="form-control" required>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tipo de Conta</label>
                            <select name="role" class="form-select" required>
                                <option value="cliente">Cliente (Comprador)</option>
                                <option value="supermercado">Supermercado (Vendedor)</option>
                                <option value="estafeta">Estafeta (Entregas)</option>
                                </select>
                        </div>
                    </div>

                    <button class="w-100 btn btn-lg btn-primary mt-4 mb-3" type="submit">Concluir Registo</button>
                </form>
                
                <div class="text-center">
                    <span class="text-muted">Já tem uma conta?</span> 
                    <a href="/users/login" class="text-decoration-none fw-bold">Inicie sessão</a>
                </div>
            </div>
        </div>
    </main>

</body>
</html>